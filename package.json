{
  "name": "react-native-barometer",
  "title": "React Native Barometer",
  "version": "2.1.0",
  "description": "Obtain barometric and altitude readings for both Android and iOS",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test __tests__/validation.test.js __tests__/watchManager.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "lib",
    "src",
    "android",
    "ios",
    "react-native-barometer.podspec",
    "react-native.config.js",
    "!ios/RNBarometer.xcodeproj",
    "!ios/RNBarometer.xcworkspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpyeates/react-native-barometer.git",
    "baseUrl": "https://github.com/dpyeates/react-native-barometer"
  },
  "keywords": [
    "react-native",
    "pressure",
    "altitude",
    "vertical speed",
    "barometer",
    "turbo-module",
    "new-architecture"
  ],
  "author": {
    "name": "Darren Yeates",
    "email": "apps@sensorworks.co.uk"
  },
  "bugs": {
    "url": "https://github.com/dpyeates/react-native-barometer/issues"
  },
  "license": "MIT",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.84"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "0.85.0",
    "typescript": "^5.8.0"
  },
  "codegenConfig": {
    "name": "RNBarometerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.sensorworks.RNBarometer"
    },
    "ios": {
      "modulesProvider": {
        "RNBarometer": "RNBarometer"
      }
    }
  },
  "sideEffects": false
}
