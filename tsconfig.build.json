{
  "compilerOptions": {
    "target": "es2019",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": ["react-native"],
    "lib": ["es2019"],
    "jsx": "react-native",
    "declaration": true,
    "outDir": "lib",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "src/**/*.ts"],
  "exclude": ["lib", "example", "**/__tests__/**"]
}
